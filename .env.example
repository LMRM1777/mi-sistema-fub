# Copia a variables de Railway. NUNCA subas valores reales a GitHub.

# --- Interruptores de seguridad ---
SMS_SENDING_ENABLED=false        # false = modo prueba: no sale ningún texto, solo se escribe en el log
VERIFY_SIGNATURES=true           # revisa que los webhooks vengan de verdad de Twilio y FUB

# --- Follow Up Boss ---
FUB_USER_API_KEY=fka_xxxxxxxx
FUB_SYSTEM_NAME=Lake-Michigan-Realty
FUB_SYSTEM_KEY=xxxxxxxx

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx   # servicio "LMRM Tracking Numbers - Lead Follow Up"

# --- Otros ---
REDIS_URL=rediss://default:xxxx@xxxx.upstash.io:6379
